              "en": "English (United Kingdom)"
            },
            {
              "v": 3,
              "pt": "Espanhol (Espanha)",
              "en": "Spanish (Spain)"
            },
            {
              "v": 20,
              "pt": "Espanhol (América Latina)",
              "en": "Spanish (Latin America)"
            },
            {
              "v": 2,
              "pt": "Francês",
              "en": "French"
            },
            {
              "v": 4,
              "pt": "Alemão",
              "en": "German"
            },
            {
              "v": 5,
              "pt": "Italiano",
              "en": "Italian"
            },
            {
              "v": 6,
              "pt": "Holandês",
              "en": "Dutch"
            },
            {
              "v": 8,
              "pt": "Russo",
              "en": "Russian"
            },
            {
              "v": 16,
              "pt": "Polonês",
              "en": "Polish"
            },
            {
              "v": 19,
              "pt": "Turco",
              "en": "Turkish"
            },
            {
              "v": 0,
              "pt": "Japonês",
              "en": "Japanese"
            },
            {
              "v": 9,
              "pt": "Coreano",
              "en": "Korean"
            },
            {
              "v": 11,
              "pt": "Chinês (simplificado)",
              "en": "Chinese (Simplified)"
            },
            {
              "v": 10,
              "pt": "Chinês (tradicional)",
              "en": "Chinese (Traditional)"
            }
          ]
        },
        {
          "key": "volume",
          "pt": "Volume",
          "en": "Volume",
          "default": 100,
          "help_pt": "Volume inicial (F5/F6 mudam durante o jogo, F8 silencia).",
          "help_en": "Starting volume (F5/F6 change it while playing, F8 mutes).",
          "min": 0,
          "max": 100,
          "step": 5
        },
        {
          "key": "mute_unfocused",
          "pt": "Silenciar em segundo plano",
          "en": "Mute in background",
          "default": 0,
          "help_pt": "Silencia o jogo quando a janela perde o foco.",
          "help_en": "Mutes the game while its window is not focused.",
          "choices": [
            {
              "v": 0,
              "pt": "Não",
              "en": "No"
            },
            {
              "v": 1,
              "pt": "Sim",
              "en": "Yes"
            }
          ]
        },
        {
          "key": "vibration",
          "pt": "Vibração do controle",
          "en": "Controller vibration",
          "default": 100,
          "help_pt": "Força da vibração; 0 desliga.",
          "help_en": "Vibration strength; 0 turns it off.",
          "min": 0,
          "max": 100,
          "step": 10
        }
      ]
    }
  ],
  "generic": {
    "play": "Play.cmd",
    "exe": "build/out/app.exe",
    "disk_gb": 1,
    "download_gb": 0.3,
    "minutes": "1-5",
    "tools": [],
    "buildtools": false,
    "gb_per_job": 1,
    "link_game": true,
    "steps": [
      {
        "name": "Convert the game for PC (AnyPS5 relinker)",
        "run": [
          "{python}",
          "../../../tools/ps5port/ps5port.py",
          "build",
          "--port",
          "{root}"
        ],
        "done_if": "build/out/app.exe"
      }
    ],
    "play_cmd": "@echo off\r\nrem Starts this game (converted by the launcher with tools/ps5port).\r\npython \"%~dp0..\\..\\..\\tools\\ps5port\\ps5port.py\" play --port \"%~dp0.\"\r\nexit /b %errorlevel%\r\n",
    "pc_menu": false
  }
}
