            {
              "v": 1,
              "pt": "Superior direito",
              "en": "Top right"
            },
            {
              "v": 2,
              "pt": "Inferior esquerdo",
              "en": "Bottom left"
            },
            {
              "v": 3,
              "pt": "Inferior direito",
              "en": "Bottom right"
            }
          ]
        },
        {
          "key": "language",
          "pt": "Idioma do console",
          "en": "Console language",
          "default": -1,
          "help_pt": "O idioma que o jogo recebe do console; o jogo usa se tiver textos nele.",
          "help_en": "The language the game gets from the console; the game uses it when it has text in it.",
