{
  "recomp": "AnyPS5 (PlayStation 5)",
  "repo": "batatinhafcbatatinha-pixel/AnyPS5",
  "branch": "main",
  "games_dir": "games",
  "setup": "tools/port-installer/setup/setup.ps1",
  "tools_dir": ".local/tools",
  "exe": "build/out/app.exe",
  "ini": "pc-settings.ini",
  "section": "opcoes",
  "ini_format": "plain",
  "vulkan_dir": null,
  "generic_label": "^[A-Z]{4}\\d{5}$",
  "deps": {
    "buildtools_gb": 0,
    "python_gb": 0.1,
    "tools": []
  },
  "groups": [
    {
      "pt": "Vídeo",
      "en": "Video",
      "items": [
        {
          "key": "modo",
          "pt": "Modo de exibição",
          "en": "Display mode",
          "default": 0,
          "help_pt": "Janela ou tela cheia na resolução da área de trabalho. F11 troca durante o jogo.",
          "help_en": "Window or fullscreen at the desktop resolution. F11 switches while playing.",
          "choices": [
            {
              "v": 0,
              "pt": "Janela",
              "en": "Window"
            },
            {
              "v": 1,
              "pt": "Tela cheia",
              "en": "Fullscreen"
            }
          ]
        },
        {
          "key": "res",
          "pt": "Resolução do jogo",
          "en": "Game resolution",
          "default": 1,
          "help_pt": "A saída de vídeo que o jogo vê. 1080p desenha bem menos pixels que 4K (mais rápido).",
          "help_en": "The video output the game sees. 1080p draws far fewer pixels than 4K (faster).",
          "choices": [
            {
              "v": 1,
              "pt": "1080p (mais rápido)",
              "en": "1080p (faster)"
            },
            {
              "v": 2,
              "pt": "4K (2160p)",
              "en": "4K (2160p)"
            },
            {
              "v": 0,
              "pt": "Automática (a do monitor)",
              "en": "Automatic (the monitor's)"
            }
          ],
          "restart": true
        },
        {
          "key": "vsync",
          "pt": "Sincronização vertical",
          "en": "Vertical sync",
          "default": 0,
          "help_pt": "Ligada espera o monitor. Sem cortes troca pelo quadro mais novo; Desligada pode cortar a imagem.",
          "help_en": "On waits for the monitor. Without tearing shows the newest frame; Off can tear.",
          "choices": [
            {
              "v": 0,
              "pt": "Ligada",
              "en": "On"
            },
            {
              "v": 1,
              "pt": "Desligada sem cortes (mailbox)",
              "en": "Off without tearing (mailbox)"
            },
            {
              "v": 2,
              "pt": "Desligada",
              "en": "Off"
            }
          ],
          "restart": true
        }
      ]
    },
    {
      "pt": "Sistema",
      "en": "System",
      "items": [
        {
          "key": "show_fps",
          "pt": "Mostrar desempenho",
          "en": "Show performance",
          "default": 0,
          "help_pt": "Painel com FPS e tempos de quadro desde o início. F10 troca durante o jogo.",
          "help_en": "Panel with FPS and frame times from the start. F10 switches while playing.",
          "choices": [
            {
              "v": 0,
              "pt": "Não",
              "en": "No"
            },
            {
              "v": 1,
              "pt": "FPS",
              "en": "FPS"
            },
            {
              "v": 2,
              "pt": "Detalhado",
              "en": "Detailed"
            }
          ]
        },
        {
          "key": "overlay_pos",
          "pt": "Posição do painel",
          "en": "Panel position",
          "default": 0,
          "help_pt": "Canto da tela do painel de desempenho.",
          "help_en": "Screen corner of the performance panel.",
          "choices": [
            {
              "v": 0,
              "pt": "Superior esquerdo",
              "en": "Top left"
